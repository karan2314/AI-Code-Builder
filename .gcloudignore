# Files NOT uploaded by `gcloud run deploy --source .`
# (backend/data and backend/models ARE uploaded: the image needs them)
.gcloudignore
.git
.gitignore
.kiro/
**/.venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
frontend/dist/
**/.env
**/.env.*
!**/.env.example
docs/*.docx
