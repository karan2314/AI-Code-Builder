<mxfile host="app.diagrams.net" agent="Kiro" version="24.7.17"><diagram id="deployed" name="1 · Deployed architecture"><mxGraphModel dx="1640" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1060" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;FraudLens AI&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;Deployed architecture on Google Cloud" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1560.0" height="34.0" as="geometry"/></mxCell><mxCell id="v2" value="ML screens every transaction · ADK agents investigate alerts with verified tools · Gemini explains · a deterministic policy decides · analysts approve" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40.0" y="54.0" width="1560.0" height="22.0" as="geometry"/></mxCell><mxCell id="v3" value="Google Cloud  ·  us-central1" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#80868b;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="180.0" y="96.0" width="1420.0" height="790.0" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a73e8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#1a73e8;" vertex="1" parent="1"><mxGeometry x="210.0" y="140.0" width="600.0" height="610.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Cloud Run  ·  fraudlens&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;public HTTPS · one container · scales 0 → 2&lt;/font&gt;" style="editableCssRules=.*;sketch=0;html=1;shape=image;aspect=fixed;imageAspect=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontColor=#202124;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="222.7" y="156.0" width="38.5" height="40.0" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b style='font-size:14px'&gt;Web app &amp;amp; API&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;React analyst workspace · FastAPI · rate limits · security headers&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=12;fontSize=12;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="240.0" y="220.0" width="540.0" height="92.0" as="geometry"/></mxCell><mxCell id="v7" value="1" style="ellipse;html=1;fillColor=#1a73e8;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="254.0" y="251.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b style='font-size:14px'&gt;Screening  (no LLM)&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;27 features → rules + gradient boosting + Isolation Forest&lt;br&gt;~0.7% of transactions become alerts&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=12;fontSize=12;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="240.0" y="340.0" width="540.0" height="92.0" as="geometry"/></mxCell><mxCell id="v9" value="2" style="ellipse;html=1;fillColor=#1a73e8;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="254.0" y="371.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b style='font-size:14px'&gt;Agentic investigation  (Google ADK)&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;Orchestrator → Behavior · Transaction · Network agents&lt;br&gt;11 guarded, deterministic tools → evidence with IDs&lt;br&gt;Deterministic fallback if the AI is unavailable&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3e8fd;strokeColor=#8430ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=12;fontSize=12;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="240.0" y="460.0" width="540.0" height="130.0" as="geometry"/></mxCell><mxCell id="v11" value="3" style="ellipse;html=1;fillColor=#8430ce;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="254.0" y="510.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b style='font-size:14px'&gt;Decision &amp;amp; response&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;Gemini summary + citation check → policy engine R1–R8&lt;br&gt;Simulated action · analyst approves or overrides&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fef7e0;strokeColor=#e37400;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=12;fontSize=12;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="240.0" y="618.0" width="540.0" height="106.0" as="geometry"/></mxCell><mxCell id="v13" value="4" style="ellipse;html=1;fillColor=#e37400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="254.0" y="656.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#80868b;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#80868b;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#80868b;strokeWidth=2;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#5f6368;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v17" value="AI &amp; models" style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8430ce;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#8430ce;" vertex="1" parent="1"><mxGeometry x="850.0" y="140.0" width="330.0" height="610.0" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Called only for alerts&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;~0.7% of transactions · daily AI cap&lt;br&gt;bounded, pseudonymous evidence only&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3e8fd;strokeColor=#8430ce;strokeWidth=1.2;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#202124;dashed=1;" vertex="1" parent="1"><mxGeometry x="870.0" y="292.0" width="290.0" height="76.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Advisory, never decisive&lt;/b&gt;&lt;br&gt;&lt;font color='#5f6368'&gt;Gemini and Laya recommend a tier;&lt;br&gt;the deterministic policy engine decides&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3e8fd;st