# Copy to backend/.env for local development. Never commit .env.
# Auth uses Application Default Credentials: `gcloud auth application-default login` (no API keys).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_SYNTH=gemini-3.5-flash
INVESTIGATION_TIMEOUT_S=45
MAX_TOOL_CALLS=12
MAX_AI_INVESTIGATIONS_PER_DAY=60
FIRESTORE_ENABLED=false
DEMO_MODE=true
RATE_LIMIT_PER_MIN=20
# Local dev: serve the built frontend from the backend
STATIC_DIR=../frontend/dist
