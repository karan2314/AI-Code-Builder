{
  "mcpServers": {
    "gcloud": {
      "command": "npx",
      "args": ["-y", "@google-cloud/gcloud-mcp@0.5.3"],
      "disabled": false
    },
    "cloud-run": {
      "command": "npx",
      "args": ["-y", "@google-cloud/cloud-run-mcp@1.11.0"],
      "env": {
        "GOOGLE_CLOUD_REGION": "us-central1",
        "DEFAULT_SERVICE_NAME": "fraudlens"
      },
      "disabled": false
    },
    "gcp-observability": {
      "command": "npx",
      "args": ["-y", "@google-cloud/observability-mcp@0.2.3"],
      "disabled": false
    },
    "bigquery": {
      "command": "npx",
      "args": ["-y", "@toolbox-sdk/server@1.14.0", "--prebuilt", "bigquery", "--stdio"],
      "env": {
        "BIGQUERY_PROJECT": "REPLACE_WITH_PROJECT_ID"
      },
      "disabled": true
    },
    "firestore": {
      "command": "npx",
      "args": ["-y", "@toolbox-sdk/server@1.14.0", "--prebuilt", "firestore", "--stdio"],
      "env": {
        "FIRESTORE_PROJECT": "REPLACE_WITH_PROJECT_ID"
      },
      "disabled": true
    },
    "gcp-storage": {
      "command": "npx",
      "args": ["-y", "@google-cloud/storage-mcp@0.6.0"],
      "disabled": true
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.11.0"],
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.4.2"],
      "disabled": false
    },
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools@15.34.0", "mcp", "--dir", "."],
      "disabled": true
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"],
      "disabled": true
    }
  }
}
