rules_version = '2';
// FraudLens: only the backend (service account via the server SDK, which bypasses rules) reads/writes
// cases and audit events. Client SDK access is denied entirely, so audit records can't be tampered with.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
